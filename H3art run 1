<!DOCTYPE html> 
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Exp3er1mentz H3art</title>

<style>
/* =====================================================
   EXP3ER1MENTZ H3ART
   Pixel-art made entirely with CSS
   ===================================================== */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #08080d;
    color: #e8e8e8;
    font-family: "Courier New", monospace;
    overflow-x: hidden;
}

button {
    font-family: inherit;
}

/* GAME */

#game {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background:
        radial-gradient(circle at center, #171521 0%, #08080d 70%);
}

.screen {
    width: min(1000px, 94vw);
    min-height: 650px;
    border: 3px solid #343443;
    background: #101018;
    box-shadow:
        0 0 0 6px #09090d,
        0 0 40px rgba(0,0,0,.8);
    position: relative;
    overflow: hidden;
}

/* =====================================================
   TITLE SCREEN
   ===================================================== */

#titleScreen {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 40px;
}

.glitch {
    font-size: clamp(30px, 6vw, 65px);
    color: #f0f0f0;
    letter-spacing: 4px;
    text-shadow:
        3px 0 #713d66,
        -3px 0 #334c70;
    animation: glitch 3s infinite;
}

.subtitle {
    color: #777787;
    margin-top: 5px;
    font-size: 14px;
}

.startButton {
    margin-top: 60px;
    padding: 16px 35px;
    background: #171722;
    border: 2px solid #777;
    color: white;
    cursor: pointer;
    font-size: 18px;
}

.startButton:hover {
    background: #292936;
    border-color: #b9b9b9;
}

.warning {
    margin-top: 35px;
    color: #555564;
    font-size: 11px;
    max-width: 500px;
}

@keyframes glitch {
    0%, 90%, 100% {
        transform: translate(0);
    }

    92% {
        transform: translate(-2px, 1px);
    }

    94% {
        transform: translate(2px, -1px);
    }
}

/* =====================================================
   GAME SCREEN
   ===================================================== */

#gameScreen {
    display: none;
    flex-direction: column;
}

.topBar {
    height: 48px;
    border-bottom: 2px solid #292934;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    color: #777787;
    font-size: 12px;
}

.location {
    color: #aaaabb;
}

.mainArea {
    flex: 1;
    position: relative;
    min-height: 470px;
    background:
        linear-gradient(
            rgba(255,255,255,.015) 50%,
            transparent 50%
        );
    background-size: 100% 4px;
}

/* Laboratory floor */

.labFloor {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 110px;
    background:
        repeating-linear-gradient(
            90deg,
            #17171f 0px,
            #17171f 48px,
            #121219 49px,
            #121219 50px
        );
    border-top: 2px solid #282833;
}

/* =====================================================
   CSS PIXEL PEOPLE
   ===================================================== */

.character {
    position: absolute;
    width: 100px;
    height: 180px;
    bottom: 65px;
}

/* Scientist */

.scientist {
    left: 17%;
}

/* Subject */

.subject {
    right: 18%;
    opacity: .75;
}

/* Pixel body */

.head {
    position: absolute;
    width: 58px;
    height: 58px;
    left: 21px;
    top: 0;
    background: #d0a087;

    box-shadow:
        8px 0 #d0a087,
        16px 0 #d0a087,
        0 8px #d0a087,
        8px 8px #d0a087,
        16px 8px #d0a087,
        24px 8px #d0a087,
        0 16px #d0a087,
        8px 16px #d0a087,
        16px 16px #d0a087,
        24px 16px #d0a087,
        8px 24px #d0a087,
        16px 24px #d0a087,
        24px 24px #d0a087,
        8px 32px #d0a087,
        16px 32px #d0a087,
        24px 32px #d0a087,
        8px 40px #d0a087,
        16px 40px #d0a087,
        24px 40px #d0a087;
}

/* Hair */

.scientist .head {
    background: #3b3131;

    box-shadow:
        8px 0 #3b3131,
        16px 0 #3b3131,
        24px 0 #3b3131,
        32px 0 #3b3131,
        40px 0 #3b3131,
        0 8px #3b3131,
        8px 8px #3b3131,
        16px 8px #3b3131,
        24px 8px #3b3131,
        32px 8px #3b3131;
}

/* Eyes */

.head::after {
    content: "";
    position: absolute;
    left: 14px;
    top: 27px;
    width: 7px;
    height: 7px;
    background: #111;

    box-shadow:
        22px 0 #111;
}

/* Body */

.body {
    position: absolute;
    top: 66px;
    left: 13px;
    width: 74px;
    height: 85px;
    background: #e7e7e7;

    box-shadow:
        8px 0 #e7e7e7,
        16px 0 #e7e7e7,
        24px 0 #e7e7e7,
        32px 0 #e7e7e7,
        40px 0 #e7e7e7,
        48px 0 #e7e7e7;
}

/* Scientist lab coat */

.scientist .body {
    background: #d8d8d8;
}

/* Subject clothing */

.subject .body {
    background: #262633;
}

/* Arms */

.arm {
    position: absolute;
    top: 73px;
    width: 22px;
    height: 70px;
    background: #d0a087;
}

.arm.left {
    left: -5px;
}

.arm.right {
    right: -5px;
}

/* Legs */

.leg {
    position: absolute;
    top: 145px;
    width: 27px;
    height: 45px;
    background: #24242d;
}

.leg.left {
    left: 19px;
}

.leg.right {
    right: 19px;
}

/* =====================================================
   DIALOGUE
   ===================================================== */

.dialogueBox {
    min-height: 135px;
    background: #0c0c13;
    border-top: 3px solid #383846;
    padding: 18px 22px;
}

.speaker {
    color: #c28ab7;
    font-weight: bold;
    margin-bottom: 8px;
}

.dialogueText {
    line-height: 1.6;
    color: #dddde5;
    min-height: 50px;
}

.continue {
    margin-top: 12px;
    color: #777787;
    font-size: 12px;
}

/* =====================================================
   CHOICES
   ===================================================== */

.choices {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
}

.choice {
    flex: 1;
    min-width: 200px;
    padding: 12px;
    background: #151520;
    color: #ddd;
    border: 1px solid #444452;
    cursor: pointer;
    text-align: left;
}

.choice:hover {
    background: #252532;
    border-color: #888;
}

/* =====================================================
   STATUS
   ===================================================== */

.status {
    position: absolute;
    top: 15px;
    right: 15px;
    color: #555565;
    font-size: 11px;
}

/* =====================================================
   MOBILE
   ===================================================== */

@media (max-width: 650px) {

    .screen {
        width: 100%;
        min-height: 100vh;
        border: none;
    }

    .mainArea {
        min-height: 430px;
    }

    .scientist {
        left: 8%;
    }

    .subject {
        right: 8%;
    }

    .character {
        transform: scale(.75);
        transform-origin: bottom center;
    }

    .dialogueBox {
        min-height: 190px;
    }

    .choice {
        min-width: 100%;
    }
}
</style>
</head>

<body>

<div id="game">

    <div class="screen">

        <!-- TITLE -->

        <section id="titleScreen">

            <div class="glitch">
                Exp3er1mentz H3art
            </div>

            <div class="subtitle">
                CLASSIFIED EXPERIMENT // FILE 001
            </div>

            <button class="startButton" onclick="startGame()">
                BEGIN EXPERIMENT
            </button>

            <div class="warning">
                PROPERTY OF THE AGENCY.  
                UNAUTHORIZED ACCESS IS PROHIBITED.
            </div>

        </section>


        <!-- GAME -->

        <section id="gameScreen">

            <div class="topBar">

                <span class="location">
                    █ LABORATORY 07
                </span>

                <span>
                    EXPERIMENT STATUS:
                    <b id="status">STABLE</b>
                </span>

            </div>


            <div class="mainArea">

                <div class="status">
                    SUBJECT: 001
                </div>

                <div class="labFloor"></div>


                <!-- SCIENTIST -->

                <div class="character scientist">

                    <div class="head"></div>

                    <div class="body"></div>

                    <div class="arm left"></div>
                    <div class="arm right"></div>

                    <div class="leg left"></div>
                    <div class="leg right"></div>

                </div>


                <!-- SUBJECT -->

                <div class="character subject">

                    <div class="head"></div>

                    <div class="body"></div>

                    <div class="arm left"></div>
                    <div class="arm right"></div>

                    <div class="leg left"></div>
                    <div class="leg right"></div>

                </div>

            </div>


            <div class="dialogueBox">

                <div class="speaker" id="speaker">
                    SYSTEM
                </div>

                <div class="dialogueText" id="dialogue">
                    Initializing experiment...
                </div>

                <div class="choices" id="choices"></div>

                <div class="continue" id="continue">
                    CLICK TO CONTINUE
                </div>

            </div>

        </section>

    </div>

</div>


<script>

/* =====================================================
   STORY SYSTEM
   ===================================================== */

const story = {

    start: {
        speaker: "YOU",
        text:
        "Another day. Another experiment. Another report nobody will ever read.",
        next: "boring"
    },

    boring: {
        speaker: "YOU",
        text:
        "The agency calls it important work. You call it Tuesday.",
        next: "classified"
    },

    classified: {
        speaker: "DIRECTOR",
        text:
        "\"Doctor. We have a new assignment for you.\"",
        next: "secret"
    },

    secret: {
        speaker: "DIRECTOR",
        text:
        "\"This project is classified. You will not discuss it with anyone.\"",
        next: "subject"
    },

    subject: {
        speaker: "YOU",
        text:
        "They bring the body into the laboratory after midnight.",
        next: "body"
    },

    body: {
        speaker: "YOU",
        text:
        "You have seen hundreds of failed experiments. This one feels different.",
        next: "experiment"
    },

    experiment: {
        speaker: "SYSTEM",
        text:
        "EXPERIMENT 001 — BEGIN.",
        choices: [
            {
                text: "Begin the procedure.",
                next: "procedure"
            },
            {
                text: "Look at the subject first.",
                next: "look"
            }
        ]
    },

    look: {
        speaker: "YOU",
        text:
        "You stare at their face. For some reason, you can't look away.",
        next: "procedure"
    },

    procedure: {
        speaker: "SYSTEM",
        text:
        "Power increasing... biological response detected...",
        next: "wake"
    },

    wake: {
        speaker: "SYSTEM",
        text:
        "HEARTBEAT DETECTED.",
        next: "eyes"
    },

    eyes: {
        speaker: "YOU",
        text:
        "Their eyes open.",
        next: "stare"
    },

    stare: {
        speaker: "YOU",
        text:
        "They look directly at you.",
        choices: [
            {
                text: "Step closer.",
                next: "closer"
            },
            {
                text: "Stay where you are.",
                next: "distance"
            }
        ]
    },

    closer: {
        speaker: "YOU",
        text:
        "You step closer. Something about them feels strangely familiar.",
        next: "hug"
    },

    distance: {
        speaker: "YOU",
        text:
        "You don't move. You tell yourself you're only observing the experiment.",
        next: "question"
    },

    hug: {
        speaker: "YOU",
        text:
        "Before you can think about it, you pull them into a hug.",
        next: "question"
    },

    question: {
        speaker: "SUBJECT",
        text:
        "\"Who are you?\"",
        choices: [
            {
                text: "Tell them your real name.",
                next: "realname"
            },
            {
                text: "Tell them your agency identification.",
                next: "agency"
            }
        ]
    },

    realname: {
        speaker: "YOU",
        text:
        "You tell them your name.",
        next: "memory"
    },

    agency: {
        speaker: "YOU",
        text:
        "\"I'm the scientist who brought you back.\"",
        next: "memory"
    },

    memory: {
        speaker: "SUBJECT",
        text:
        "\"I don't remember anything...\"",
        next: "ending"
    },

    ending: {
        speaker: "YOU",
        text:
        "You should be documenting the experiment. Instead, you're watching them breathe.",
        choices: [
            {
                text: "Continue the experiment.",
                next: "continueExperiment"
            },
            {
                text: "Protect the subject.",
                next: "protect"
            }
        ]
    },

    continueExperiment: {
        speaker: "SYSTEM",
        text:
        "NEW EXPERIMENT PARAMETERS REQUIRED.",
        next: "final"
    },

    protect: {
        speaker: "YOU",
        text:
        "For the first time in your career, you decide the agency doesn't get to decide what happens next.",
        next: "final"
    },

    final: {
        speaker: "SYSTEM",
        text:
        "END OF DEMO — THE EXPERIMENT HAS ONLY JUST BEGUN.",
        choices: [
            {
                text: "Restart",
                next: "restart"
            }
        ]
    }

};


/* =====================================================
   GAME VARIABLES
   ===================================================== */

let currentScene = "start";


/* =====================================================
   START
   ===================================================== */

function startGame() {

    document.getElementById("titleScreen").style.display = "none";

    document.getElementById("gameScreen").style.display = "flex";

    showScene("start");
}


/* =====================================================
   SHOW SCENE
   ===================================================== */

function showScene(sceneName) {

    if (sceneName === "restart") {

        location.reload();

        return;
    }

    currentScene = sceneName;

    const scene = story[sceneName];

    const speaker =
        document.getElementById("speaker");

    const dialogue =
        document.getElementById("dialogue");

    const choices =
        document.getElementById("choices");

    const continueText =
        document.getElementById("continue");

    speaker.textContent = scene.speaker;

    dialogue.textContent = scene.text;

    choices.innerHTML = "";

    continueText.style.display = "none";


    /* Choices */

    if (scene.choices) {

        scene.choices.forEach(choice => {

            const button =
                document.createElement("button");

            button.className = "choice";

            button.textContent = choice.text;

            button.onclick = () => {

                showScene(choice.next);

            };

            choices.appendChild(button);

        });

    }

    /* Normal continuation */

    else if (scene.next) {

        continueText.style.display = "block";

        continueText.textContent =
            "CLICK TO CONTINUE";

        document.getElementById("dialogueBox");

        continueText.onclick = () => {

            showScene(scene.next);

        };

        continueText.style.cursor = "pointer";

    }

}


/* =====================================================
   KEYBOARD SUPPORT
   ===================================================== */

document.addEventListener("keydown", function(event) {

    if (event.key === "Enter") {

        const scene = story[currentScene];

        if (scene && scene.next && !scene.choices) {

            showScene(scene.next);

        }

    }

});

</script>

</body>
</html>
